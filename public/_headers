/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob:; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/hanzi/*
  Cache-Control: public, max-age=86400

/voice/*
  Cache-Control: public, max-age=86400

/dictionary/*
  Cache-Control: public, max-age=3600
